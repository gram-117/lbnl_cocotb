 .timescale -9 -9;
    .port_info 0 /INPUT 1 "clk";
o0x71ccc59a0018 .functor BUFZ 1, C4<z>; HiZ drive
v0x56a4ec59a430_0 .net "clk", 0 0, o0x71ccc59a0018;  0 drivers
L_0x71ccc5957018 .functor BUFT 1, C4<x>, C4<0>, C4<0>, C4<0>;
v0x56a4ec5cf260_0 .net "my_signal_1", 0 0, L_0x71ccc5957018;  1 drivers
L_0x71ccc5957060 .functor BUFT 1, C4<0>, C4<0>, C4<0>, C4<0>;
v0x56a4ec5cf320_0 .net "my_signal_2", 0 0, L_0x71ccc5957060;  1 drivers
